@model IEnumerable<FoodInventory.Models.Recipe>
@{
    ViewData["Title"] = "Zarządzanie Przepisami";
}

<div class="row">
    <div class="col-md-8">
        <h2>Baza Przepisów Kulinarnych 🍳</h2>
        <table class="table table-bordered mt-3">
            <thead>
                <tr>
                    <th>Nazwa przepisu</th>
                    <th>Czas (min)</th>
                    <th>Składniki</th>
                    <th>Instrukcja</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td><strong>@r.Name</strong></td>
                        <td>@r.PrepTimeMinutes</td>
                        <td>
                            <ul>
                                @foreach (var rp in r.RecipeProducts)
                                {
                                    <li>@rp.Product.Name - @rp.Quantity @rp.Unit</li>
                                }
                            </ul>
                        </td>
                        <td>@r.Instructions</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="col-md-4 bg-light p-4 rounded">
        <h4>Dodaj nowy przepis</h4>
        <form method="post" action="/Admin/AddRecipe">
            <div class="mb-3">
                <label class="form-label">Nazwa potrawy</label>
                <input type="text" name="name" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Czas przygotowania (min)</label>
                <input type="number" name="prepTimeMinutes" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Instrukcja wykonania</label>
                <textarea name="instructions" class="form-control" rows="3" required></textarea>
            </div>
            <hr />
            <h5>Główny składnik:</h5>
            <div class="mb-3">
                <label class="form-label">Produkt</label>
                <select name="productId" class="form-select" required>
                    @foreach (var p in ViewBag.Products)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
            </div>
            <div class="row">
                <div class="col-6 mb-3">
                    <label class="form-label">Ilość</label>
                    <input type="number" step="0.1" name="quantity" class="form-control" required />
                </div>
                <div class="col-6 mb-3">
                    <label class="form-label">Jednostka</label>
                    <input type="text" name="unit" class="form-control" placeholder="np. g, szt" required />
                </div>
            </div>
            <button type="submit" class="btn btn-danger w-100">Dodaj przepis</button>
        </form>
    </div>
</div>