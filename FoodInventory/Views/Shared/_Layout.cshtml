@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FoodInventory</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">Food Inventory 🍏</a>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-collapse navbar-nav flex-grow-1">
                        @if (Context.Session.GetString("Username") != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Home/Index">Moja Lodówka</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Home/ShoppingList">Lista Zakupów</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Home/Recipes">Przepisy</a>
                            </li>

                            @if (Context.Session.GetString("Role") == "Admin")
                            {
                                <li class="nav-item">
                                    <span class="nav-link text-danger">| <strong>Panel Admina:</strong></span>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-danger" href="/Admin/Products">Produkty Baza</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-danger" href="/Admin/Categories">Kategorie</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-danger" href="/Admin/Users">Użytkownicy</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-danger" href="/Admin/Recipes">Przepisy Baza</a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (Context.Session.GetString("Username") != null)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-dark">Cześć, <strong>@Context.Session.GetString("Username")</strong>!</span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-danger btn-sm mt-1" href="/Account/Logout">Wyloguj</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Account/Login">Logowanie</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" href="/Account/Register">Rejestracja</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>