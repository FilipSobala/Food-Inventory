@model IEnumerable<FoodInventory.Models.UserProduct>
@{
    ViewData["Title"] = "Moja Lodówka";
}

<div class="row">
    <div class="col-md-8">
        <h2>Co masz w lodówce 🧊</h2>
        <table class="table table-striped mt-3">
            <thead>
                <tr>
                    <th>Kat.</th>
                    <th>Produkt</th>
                    <th>Ilość</th>
                    <th>Data ważności</th>
                    <th>Uwagi</th>
                    <th>Akcja</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var czyPrzeterminowany = item.ExpiryDate < DateTime.Now;
                    <tr class="@(czyPrzeterminowany ? "table-danger" : "")">
                        <td>@item.Product.Category.Icon</td>
                        <td><strong>@item.Product.Name</strong></td>
                        <td>@item.Quantity @item.Unit</td>
                        <td>
                            @item.ExpiryDate.ToString("dd.MM.yyyy")
                            @if (czyPrzeterminowany) { <span class="badge bg-danger">Przeterminowane!</span> }
                        </td>
                        <td>@item.Notes</td>
                        <td>
                            <a href="/Home/RemoveProduct/@item.Id" class="btn btn-sm btn-success">Zużyte / Usuń</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="col-md-4 bg-light p-4 rounded">
        <h4>Dodaj produkt do lodówki</h4>
        <form method="post" action="/Home/AddProduct">
            <div class="mb-3">
                <label class="form-label">Produkt bazowy</label>
                <select name="productId" class="form-select" required>
                    @foreach (var p in ViewBag.AllProducts)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Ilość</label>
                <input type="number" step="0.1" name="quantity" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Jednostka</label>
                <input type="text" name="unit" class="form-control" placeholder="np. szt, kg, l" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Data ważności</label>
                <input type="date" name="expiryDate" class="form-control" value="@DateTime.Now.AddDays(7).ToString("yyyy-MM-dd")" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Notatki</label>
                <input type="text" name="notes" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary w-100">Włóż do lodówki</button>
        </form>
    </div>
</div>