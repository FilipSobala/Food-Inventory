@model IEnumerable<FoodInventory.Models.ShoppingList>
@{
    ViewData["Title"] = "Lista Zakupów";
}

<h2>Twoja Lista Zakupów 🛒</h2>

<div class="row mt-4">
    <div class="col-md-8">
        <div class="d-flex justify-content-between mb-3">
            <h5>Artykuły do kupienia</h5>
            <a href="/Home/ClearBought" class="btn btn-sm btn-outline-secondary">Usuń kupione</a>
        </div>
        <ul class="list-group">
            @foreach (var item in Model)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <input type="checkbox" class="form-check-input me-2" @(item.IsBought ? "checked" : "") 
                               onclick="location.href='/Home/ToggleBought/@item.Id'" />
                        <span style="@(item.IsBought ? "text-decoration: line-through; color: gray;" : "")">
                            <strong>@item.Product.Name</strong> - @item.Quantity @item.Unit
                        </span>
                    </div>
                </li>
            }
        </ul>
    </div>

    <div class="col-md-4 bg-light p-4 rounded">
        <h4>Dodaj do listy</h4>
        <form method="post" action="/Home/AddToShoppingList">
            <div class="mb-3">
                <label class="form-label">Produkt</label>
                <select name="productId" class="form-select" required>
                    @foreach (var p in ViewBag.AllProducts)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Ilość</label>
                <input type="number" step="0.1" name="quantity" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Jednostka</label>
                <input type="text" name="unit" class="form-control" placeholder="szt, kg" required />
            </div>
            <button type="submit" class="btn btn-success w-100">Dodaj</button>
        </form>
    </div>
</div>